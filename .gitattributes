# Shell scripts run on Linux, where a carriage return is not whitespace.
*.sh text eol=lf

# The agent reads Markdown front matter line by line, and a Windows checkout
# must not turn a working role, skill or template into a malformed one.
*.md text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# The window's stylesheet and script are read with include_str! by the UI
# contract tests, which compare exact text. A Windows checkout used to convert
# them to CRLF, so a rule that was present failed its test on one platform only.
*.css text eol=lf
*.js text eol=lf

# Images and fonts are bytes; never touch them.
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
